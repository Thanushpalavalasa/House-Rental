# Dependency directories
# This folder is generated by 'npm install' and can be huge.
# It should always be ignored as it can be recreated from package.json.
node_modules/

# Environment variables file
# CRITICAL: This file contains your secrets (database password, JWT secret).
# NEVER commit this file to a public repository.
.env

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional: Operating system files
.DS_Store
Thumbs.db